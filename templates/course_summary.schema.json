{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "course_summary.schema.json",
  "title": "פלט של סוכן קורס",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "course",
    "offerings",
    "overview",
    "units",
    "concepts",
    "assignments",
    "exams",
    "exam_patterns",
    "strengths",
    "weaknesses",
    "lecture_extras",
    "gaps",
    "files_read"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "course": {
      "description": "מגיע מוכן בקלט. מעתיקים כמו שהוא.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name_he"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/slug"
        },
        "name_he": {
          "type": "string"
        },
        "name_en": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "offerings": {
      "description": "מגיע מוכן בקלט. הסוכן ממלא רק final_grade, ורק כשהוא ריק בקלט ומופיע בקובץ.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moodle_id",
          "year",
          "semester",
          "kind",
          "final_grade"
        ],
        "properties": {
          "moodle_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "year": {
            "type": "string",
            "pattern": "^20[0-9]{2}-[0-9]{2}$"
          },
          "semester": {
            "enum": [
              "א",
              "ב",
              "קיץ"
            ]
          },
          "kind": {
            "enum": [
              "regular",
              "reinforcement",
              "other"
            ]
          },
          "final_grade": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/grade"
              }
            ]
          }
        }
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "goals",
        "prerequisites"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 1200
        },
        "goals": {
          "description": "מה הייתי אמור לקחת איתי",
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "units": {
      "description": "מה למדתי, לפי הסדר",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "offering",
          "order",
          "kind",
          "title",
          "summary",
          "concepts_defined",
          "concepts_used",
          "src"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^u[0-9]{2,3}$"
          },
          "offering": {
            "type": [
              "integer",
              "null"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "lecture",
              "recitation",
              "lab",
              "reading",
              "paper",
              "research_question",
              "other"
            ]
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "maxLength": 900
          },
          "concepts_defined": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/slug"
            }
          },
          "concepts_used": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/slug"
            }
          },
          "src": {
            "$ref": "#/$defs/srcs"
          }
        }
      }
    },
    "concepts": {
      "description": "במה נגעתי. הסוכן המרכזי מאחד לפי key.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "name_he",
          "name_en",
          "aliases",
          "kind",
          "role",
          "statement",
          "defined_at",
          "appears_at",
          "depends_on",
          "my_level",
          "level_basis"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/slug"
          },
          "name_he": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "enum": [
              "definition",
              "theorem",
              "lemma",
              "algorithm",
              "technique",
              "model",
              "notation",
              "other"
            ]
          },
          "role": {
            "enum": [
              "defined",
              "used"
            ]
          },
          "statement": {
            "type": "string",
            "maxLength": 700
          },
          "defined_at": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/ref"
              }
            ]
          },
          "appears_at": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/slug"
            }
          },
          "my_level": {
            "enum": [
              "strong",
              "ok",
              "weak",
              "unknown"
            ]
          },
          "level_basis": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/basis"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "defined"
                }
              }
            },
            "then": {
              "properties": {
                "defined_at": {
                  "$ref": "#/$defs/ref"
                },
                "statement": {
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "my_level": {
                  "enum": [
                    "strong",
                    "ok",
                    "weak"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "level_basis": {
                  "$ref": "#/$defs/basis"
                }
              }
            }
          }
        ]
      }
    },
    "assignments": {
      "description": "שיעורי הבית. מועד ההגשה מגיע מהמודל לפי moodle_id, לא מכאן.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "moodle_id",
          "offering",
          "title",
          "task",
          "concepts",
          "task_src",
          "my_submission",
          "official_solution",
          "grade",
          "feedback",
          "correctness",
          "correctness_note",
          "mistakes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^a[0-9]{2}$"
          },
          "moodle_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "offering": {
            "type": [
              "integer",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "task": {
            "type": "string",
            "maxLength": 900
          },
          "concepts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/slug"
            }
          },
          "task_src": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "my_submission": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "official_solution": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "grade": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/grade"
              }
            ]
          },
          "feedback": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/claim"
            }
          },
          "correctness": {
            "$ref": "#/$defs/correctness"
          },
          "correctness_note": {
            "type": "string"
          },
          "mistakes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/mistake"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "correctness": {
                  "const": "graded"
                }
              }
            },
            "then": {
              "properties": {
                "grade": {
                  "$ref": "#/$defs/grade"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "correctness": {
                  "const": "feedback"
                }
              }
            },
            "then": {
              "properties": {
                "feedback": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "correctness": {
                  "const": "estimate"
                }
              }
            },
            "then": {
              "properties": {
                "correctness_note": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "exams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "offering",
          "title",
          "kind",
          "src",
          "questions",
          "my_grade",
          "my_solution",
          "official_solution",
          "correctness",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e[0-9]{2}$"
          },
          "offering": {
            "type": [
              "integer",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "past_exam",
              "my_exam",
              "quiz",
              "practice"
            ]
          },
          "src": {
            "$ref": "#/$defs/srcs"
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "n",
                "topic",
                "concepts",
                "points",
                "type"
              ],
              "properties": {
                "n": {
                  "type": "string"
                },
                "topic": {
                  "type": "string"
                },
                "concepts": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/slug"
                  }
                },
                "points": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "type": {
                  "type": "string",
                  "description": "למשל: הוכחה, בנייה, הפרכה, חישוב, אמריקאית"
                }
              }
            }
          },
          "my_grade": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/grade"
              }
            ]
          },
          "my_solution": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "official_solution": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "correctness": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/correctness"
              }
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "exam_patterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/judgement"
      }
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/judgement"
      }
    },
    "lecture_extras": {
      "description": "מה המרצה אמר בהקלטה ולא מופיע בשקפים",
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "kind"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "missing_file",
              "unreadable",
              "contradiction",
              "no_source",
              "other"
            ]
          },
          "file": {
            "$ref": "#/$defs/file_id"
          }
        }
      }
    },
    "files_read": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "status",
          "note"
        ],
        "properties": {
          "file": {
            "$ref": "#/$defs/file_id"
          },
          "status": {
            "enum": [
              "read",
              "partial",
              "unreadable",
              "irrelevant"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "progression": {
      "description": "התקדמות לאורך זמן: כל מועד, בוחן ועבודה עם תאריך וציון, לפי הסדר, ומה השתפר ומה חזר",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeline",
        "summary"
      ],
      "properties": {
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "offering",
              "event",
              "score",
              "src"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^20[0-9]{2}-[0-9]{2}(-[0-9]{2})?$"
              },
              "offering": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "event": {
                "type": "string",
                "description": "למשל: מועד א, מועד ב, בוחן 1, עבודה 3"
              },
              "score": {
                "type": [
                  "number",
                  "string",
                  "null"
                ]
              },
              "max": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "topics_weak": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/slug"
                }
              },
              "topics_strong": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/slug"
                }
              },
              "note": {
                "type": "string"
              },
              "src": {
                "$ref": "#/$defs/srcs"
              }
            }
          }
        },
        "summary": {
          "type": "string",
          "maxLength": 1500,
          "description": "מה השתנה בין הניסיונות: נושאים שהשתפרו, טעויות שחזרו, ומה זה אומר לקראת הניסיון הבא"
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "file_id": {
      "type": "string",
      "pattern": "^[ft]_[0-9a-f]{8}$",
      "description": "f_ לקובץ, t_ לתמליל"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/file_id"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "page_end": {
          "type": "integer",
          "minimum": 1
        },
        "time": {
          "type": "string",
          "pattern": "^[0-9]{1,2}:[0-5][0-9]:[0-5][0-9]$"
        }
      },
      "oneOf": [
        {
          "required": [
            "page"
          ]
        },
        {
          "required": [
            "time"
          ]
        }
      ]
    },
    "srcs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "src"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "src": {
          "$ref": "#/$defs/srcs"
        }
      }
    },
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "max",
        "src"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "src": {
          "oneOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "const": "moodle"
            }
          ]
        }
      }
    },
    "correctness": {
      "enum": [
        "graded",
        "feedback",
        "estimate",
        "unknown"
      ]
    },
    "basis": {
      "enum": [
        "grade",
        "feedback",
        "repeated_mistake",
        "unsolved",
        "self_note",
        "estimate"
      ]
    },
    "mistake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "concept",
        "basis",
        "src"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "concept": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/slug"
            }
          ]
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "src": {
          "$ref": "#/$defs/srcs"
        }
      }
    },
    "judgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "concepts",
        "basis",
        "src"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "concepts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "src": {
          "$ref": "#/$defs/srcs"
        }
      }
    }
  }
}